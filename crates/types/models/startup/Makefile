# Verdicts for the startup lifecycle model. `make check` runs every
# configuration documented in startup.pml's header and asserts its
# verdict; a clean pass prints one PASS line per verdict.
#
# The cells file (startup_cells.pml) is generated from the spec tables;
# `make cells` regenerates it through cargo and fails on drift. The
# same freshness is asserted by `cargo test -p surfpool-types`
# (the_pml_cells_are_current), so CI catches a stale file without spin.
#
# `make graphs` renders each failing verdict's trail as a Mermaid
# flowchart in trail-graphs.md, which GitHub renders; it needs the
# spintrail tool on PATH, or SPINTRAIL pointed at it.
#
# Gotcha: spin silently drops -D flags that follow -search, so flags
# come first in every recipe.

SPIN ?= spin
SPINTRAIL ?= spintrail
GRAPHS ?= trail-graphs.md

# $(1) name, $(2) -D flags, $(3) extra flags after -search, $(4) meaning.
# Arguments must avoid commas and single quotes.
define check_clean
	@out=$$($(SPIN) $(2) -search $(3) startup.pml 2>&1); \
	if echo "$$out" | grep -q "errors: 0"; then \
		echo "PASS startup/$(1): $(4)"; \
	else \
		echo "FAIL startup/$(1): expected errors: 0"; \
		echo "$$out" | tail -25; exit 1; \
	fi
endef

# $(1) name, $(2) -D flags, $(3) grep pattern, $(4) meaning
define check_error
	@out=$$($(SPIN) $(2) -search startup.pml 2>&1); \
	if echo "$$out" | grep -q "$(3)"; then \
		echo "PASS startup/$(1): $(4)"; \
	else \
		echo "FAIL startup/$(1): expected $(3)"; \
		echo "$$out" | tail -25; exit 1; \
	fi
endef

# $(1) name, $(2) -D flags, $(3) a symbol from the assert, $(4) meaning
define check_assert
	@out=$$($(SPIN) $(2) -search startup.pml 2>&1); \
	if echo "$$out" | grep -q "assertion violated" \
		&& echo "$$out" | grep -q "$(3)"; then \
		echo "PASS startup/$(1): $(4)"; \
	else \
		echo "FAIL startup/$(1): expected an assertion violation naming $(3)"; \
		echo "$$out" | tail -25; exit 1; \
	fi
endef

# $(1) heading, $(2) -D flags, $(3) verdict text. The same -D flags
# feed the search and the replay, so the rendering cannot drift from
# the trail it walks.
define graph_section
	@{ echo ''; echo '## $(1)'; echo ''; \
	   echo '    spin $(strip $(2)) -search startup.pml'; \
	   echo '      -> $(3)'; echo ''; } >> $(GRAPHS); \
	$(SPIN) $(2) -search startup.pml >/dev/null 2>&1; \
	test -f startup.pml.trail \
		|| { echo "FAIL graphs: no trail for $(1)"; exit 1; }; \
	echo '```mermaid' >> $(GRAPHS); \
	$(SPINTRAIL) $(2) startup.pml >> $(GRAPHS) \
		|| { echo "FAIL graphs: spintrail failed on $(1)"; exit 1; }; \
	echo '```' >> $(GRAPHS)
endef

.PHONY: all check cells graphs clean help

all: check ## run every verdict

help: ## show this table
	@printf '\n\033[36m%s\033[0m   spin: %s\n\n' 'startup lifecycle model' '$(SPIN)'
	@printf '  \033[1m%-12s %s\033[0m\n' 'you type' 'what happens'
	@awk 'BEGIN { FS = ":.*##" } \
		/^[A-Za-z_-]+:.*##/ { d = $$2; sub(/^ +/, "", d); \
			printf "  \033[36mmake %-7s\033[0m %s\n", $$1, d }' \
		$(firstword $(MAKEFILE_LIST))
	@printf '\n'

check: ## every documented verdict
	$(call check_clean,steady,,,every schedule of sealing and concurrent task runs ends startup Ready or Failed)
	$(call check_clean,ungated,-DUNGATED,,the terminal table rows keep the projection stable without the not-over gate)
	$(call check_assert,skipstart,-DSKIPSTART,plan_state,a completion that skips its start is refused by the cells and startup never finishes)
	$(call check_error,wedge,-DWEDGE,invalid end state,a runner waiting for a seal that planning failure never produces blocks forever)
	$(call check_clean,ready-stable,-DLTL,-a -ltl ready_stable,readiness once observed is never observed absent)
	$(call check_clean,completes,-DLTL,-a -f -ltl completes,every fair schedule reaches Ready or Failed)
	@rm -f pan pan.* *.trail _spin_nvr.tmp

graphs: ## render the failing verdicts as Mermaid in trail-graphs.md
	@{ echo '# Counterexample trails, rendered'; echo ''; \
	   echo 'Generated by `make graphs`: each failing configuration is'; \
	   echo 're-run and its trail rendered as Mermaid by spintrail.'; \
	   echo 'Regenerate after any model or cells change. Clean'; \
	   echo 'configurations leave no trail, so no graph.'; } > $(GRAPHS)
	$(call graph_section,skipstart: the completion that skips its start,-DSKIPSTART,assertion violated: the cells refuse the completion and startup never finishes)
	$(call graph_section,wedge: the runner that waits for a seal planning failure never produces,-DWEDGE,invalid end state: both runners block forever and the join never completes)
	@rm -f pan pan.* *.trail _spin_nvr.tmp

cells: ## regenerate the cells from the spec tables and fail on drift
	cd ../../../.. && cargo surfpool-update-startup-pml
	git diff --exit-code startup_cells.pml

clean: ## remove the compiled verifier, spin scratch files, and trails
	rm -f pan pan.* *.trail _spin_nvr.tmp
