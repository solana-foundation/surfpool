{
  "name": "@solana/surfpool",
  "version": "1.5.0",
  "description": "Embed a Surfpool Solana runtime in your Node.js tests",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kit": {
      "import": {
        "types": "./dist/kit/esm/index.d.ts",
        "default": "./dist/kit/esm/index.js"
      },
      "require": {
        "types": "./dist/kit/index.d.ts",
        "default": "./dist/kit/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "dist/**",
    "surfpool-sdk/internal.d.ts",
    "surfpool-sdk/internal.js"
  ],
  "napi": {
    "name": "surfpool-sdk",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu"
      ]
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solana-foundation/surfpool.git",
    "directory": "crates/sdk-node"
  },
  "homepage": "https://github.com/solana-foundation/surfpool",
  "bugs": {
    "url": "https://github.com/solana-foundation/surfpool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:debug": "npm run build:native:debug && npm run build:ts",
    "build:native": "napi build --platform --release surfpool-sdk --dts internal.d.ts --js internal.js",
    "build:native:debug": "napi build --platform surfpool-sdk --dts internal.d.ts --js internal.js",
    "build:ts": "tsc && tsc -p tsconfig.kit.json && tsc -p tsconfig.kit.esm.json && node ./scripts/sync-dist.js",
    "create-npm-dir": "napi create-npm-dir -t .",
    "generate:kit-types": "node ./scripts/generate-kit-types.js",
    "artifacts": "napi artifacts",
    "pack:dry-run": "npm pack --dry-run",
    "prepare-release": "node ./scripts/prepare-release.js",
    "smoke": "npm test",
    "test": "npm run typecheck:kit && node --test --test-concurrency=1 ./scripts/smoke.js ./scripts/kit-unit.js ./scripts/kit-smoke.js",
    "typecheck:kit": "tsc -p tsconfig.kit.typetests.json"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@solana/kit": "^8.0.0",
    "@solana/kit-plugin-rpc": "^0.18.0",
    "@solana/kit-plugin-signer": "^0.18.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@solana/kit": "^8.0.0",
    "@solana/kit-plugin-rpc": "^0.18.0",
    "@solana/kit-plugin-signer": "^0.18.0"
  },
  "peerDependenciesMeta": {
    "@solana/kit": {
      "optional": true
    },
    "@solana/kit-plugin-rpc": {
      "optional": true
    },
    "@solana/kit-plugin-signer": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@solana/surfpool-darwin-x64": "1.5.0",
    "@solana/surfpool-darwin-arm64": "1.5.0",
    "@solana/surfpool-linux-x64-gnu": "1.5.0"
  }
}
